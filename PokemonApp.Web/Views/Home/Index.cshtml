@model List<PokemonApp.Web.Models.PokemonDto>

@{
    ViewData["Title"] = "Pokédex Grid";
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();
}

<div class="text-center mb-4">
    <h1 class="display-4 text-danger font-weight-bold">Pokédex .NET 8</h1>
    <p class="text-muted">Explora los Pokémon obtenidos mediante el consumo de la PokeAPI.</p>
</div>

<div class="container mb-4">
    <!-- Alertas de éxito o error para el correo -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success text-center fw-bold">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <form method="get" asp-action="Index" class="row g-2 justify-content-center align-items-center mt-2">
        <div class="col-md-3">
            <input type="text" name="nombre" class="form-control" placeholder="Buscar por nombre..." value="@Context.Request.Query["nombre"]" />
        </div>
        <div class="col-md-3">
            <select name="tipo" class="form-select">
                <option value="">-- Todos los tipos --</option>
                @foreach (var t in tipos)
                {
                    <option value="@t" selected="@(Context.Request.Query["tipo"] == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-danger w-100 fw-bold">Filtrar</button>
        </div>

        <div class="col-md-2">
            <a href="@Url.Action("ExportarExcel", "Home", new { nombre = Context.Request.Query["nombre"], tipo = Context.Request.Query["tipo"], offset = ViewBag.Offset })" class="btn btn-success w-100 fw-bold">
                📄 Excel
            </a>
        </div>

        <!-- BOTÓN DE CORREO -->
        <div class="col-md-2">
            <a href="@Url.Action("EnviarCorreo", "Home", new { nombre = Context.Request.Query["nombre"], tipo = Context.Request.Query["tipo"], offset = ViewBag.Offset })" class="btn btn-warning w-100 fw-bold">
                ✉️ Correo
            </a>
        </div>
    </form>
</div>

<!-- GRID DE POKÉMON -->
<div class="container">
    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var pokemon in Model)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-lg text-center p-3" style="background-color: #f8f9fa;">
                        <div class="badge bg-secondary position-absolute top-0 end-0 m-2">#@pokemon.Id</div>
                        <img src="@pokemon.ImageUrl" class="card-img-top mx-auto mt-2" alt="@pokemon.Name" style="width: 120px; height: 120px; object-fit: contain;" />
                        <div class="card-body">
                            <h5 class="card-title text-capitalize font-weight-bold">@pokemon.Name</h5>
                            <a href="https://www.pokemon.com/es/pokedex/@pokemon.Name" target="_blank" class="btn btn-outline-danger btn-sm mt-2">Ver detalles</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="text-danger">No se pudieron cargar los Pokémon en este momento.</p>
            </div>
        }
    </div>
</div>

<!-- PAGINACIÓN -->
<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center">
        @if (ViewBag.Offset > 0)
        {
            <a href="?nombre=@ViewBag.Nombre&tipo=@ViewBag.Tipo&offset=@(ViewBag.Offset - 20)" class="btn btn-outline-danger fw-bold px-4">
                &laquo; Anterior
            </a>
        }
        else
        {
            <button class="btn btn-outline-secondary fw-bold px-4" disabled>&laquo; Anterior</button>
        }

        <span class="text-muted fw-bold">Paginación Manual</span>

        <a href="?nombre=@ViewBag.Nombre&tipo=@ViewBag.Tipo&offset=@(ViewBag.Offset + 20)" class="btn btn-danger fw-bold px-4">
            Siguiente &raquo;
        </a>
    </div>
</div>